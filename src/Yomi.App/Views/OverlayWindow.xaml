<Window x:Class="Yomi.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yomi.App.Views"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False">
    <Border x:Name="BackgroundBorder" Background="#FF101010" CornerRadius="6" Padding="12">
        <StackPanel>
            <StackPanel x:Name="CpuSection">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CpuLabelText" Grid.Column="0" Text="CPU" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="CpuValueText" Grid.Column="1" Text="--%" Foreground="#7FDBFF" FontSize="14"/>
                </Grid>
                <TextBlock x:Name="CpuNameText" Text="--" Foreground="#999999" FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <local:GraphControl x:Name="CpuGraph" Height="90" LineBrush="#7FDBFF" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="MemorySection">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MemoryLabelText" Grid.Column="0" Text="メモリ" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="MemoryValueText" Grid.Column="1" Text="--" Foreground="#B6F542" FontSize="14"/>
                </Grid>
                <local:GraphControl x:Name="MemoryGraph" Height="90" LineBrush="#B6F542" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="GpuSection">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GpuLabelText" Grid.Column="0" Text="GPU" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="GpuValueText" Grid.Column="1" Text="--%" Foreground="#FFB347" FontSize="14"/>
                </Grid>
                <TextBlock x:Name="GpuNameText" Text="--" Foreground="#999999" FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <local:GraphControl x:Name="GpuGraph" Height="90" LineBrush="#FFB347" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="VramSection">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VramLabelText" Grid.Column="0" Text="VRAM" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="VramValueText" Grid.Column="1" Text="--" Foreground="#FF7F9E" FontSize="14"/>
                </Grid>
                <local:GraphControl x:Name="VramGraph" Height="90" LineBrush="#FF7F9E" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="NetworkSection">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NetworkIpLabelText" Grid.Column="0" Text="IPアドレス" Foreground="White" FontSize="11"/>
                </Grid>
                <TextBlock x:Name="IpAddressText" Text="--" Foreground="#C9A8FF" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NetworkDnsLabelText" Grid.Column="0" Text="DNS" Foreground="White" FontSize="11"/>
                </Grid>
                <TextBlock x:Name="DnsText" Text="--" Foreground="#C9A8FF" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
