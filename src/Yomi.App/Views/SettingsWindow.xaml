<Window x:Class="Yomi.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="yomi 設定" Width="660" Height="760" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#F5F6FA" Foreground="#202536" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#4FC2F7"/>
        <Style x:Key="CaptionKeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="4" BorderBrush="{StaticResource Accent}" BorderThickness="1" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#202536"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CaptionKeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#E2E5ED"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#CDD2DF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#C42B3C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#A92130"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderBrush" Value="#E2E5ED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="152"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="#FCFCFE"/>
            <Setter Property="BorderBrush" Value="#C9CEDB"/>
            <Setter Property="Foreground" Value="#202536"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Selector" Background="#FCFCFE" BorderBrush="#C9CEDB" BorderThickness="1" CornerRadius="6">
                                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#626B7E" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selector" Property="Background" Value="#F0F1F7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,6,38,6" VerticalAlignment="Center"/>
                            <Border x:Name="SelectorFocus" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#C9CEDB" BorderThickness="1" CornerRadius="6" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectorFocus" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Option" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#E5F6FD"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#626B7E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FCFCFE"/>
            <Setter Property="Foreground" Value="#202536"/>
            <Setter Property="BorderBrush" Value="#C9CEDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Invalid">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#C42B3C"/>
                                <Setter TargetName="Field" Property="Background" Value="#FFF5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD2DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#202536"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Padding="20,16" BorderBrush="#E2E5ED" BorderThickness="0,0,0,1">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" Margin="0,0,16,0"/>
                            <Grid Grid.Column="1" Width="42" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="#DDE1EA" BorderBrush="#ABB3C3" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Last"><Setter TargetName="Row" Property="BorderThickness" Value="0"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#202536"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent">
                            <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="#626B7E" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#E5F6FD"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="#155F80"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#C9CEDB" BorderThickness="1">
    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeButton_Click" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="ToolTip" Value="最大化"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="ToolTip" Value="元のサイズに戻す"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="28,12,28,18">
            <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold"/>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="2" Margin="28,0,28,0" Background="Transparent" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ItemsPresenter Margin="0,0,0,18"/>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabItem Header="表示とデザイン">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="デザイン" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox x:Name="EModeCheck" AutomationProperties.Name="Eモード" Checked="EModeCheck_Changed" Unchecked="EModeCheck_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Eモード"/>
                                        <TextBlock Text="黒背景・黄色の文字と外枠に切り替えます。" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="背景の透明度" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="OpacityCombo" Grid.Column="1" AutomationProperties.Name="背景の透明度"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="背景色" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="BackgroundColorCombo" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="背景色">
                                            <ComboBoxItem Content="黒" Tag="Black"/>
                                            <ComboBoxItem Content="白" Tag="White"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><StackPanel>
                                    <TextBlock Text="表示する項目" Style="{StaticResource Heading}" Margin="0"/>
                                    <TextBlock Text="必要な情報だけをパネルに表示できます。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                                <CheckBox x:Name="ShowClockCheck" Content="日付・時計"/>
                                <CheckBox x:Name="ShowWorkHoursCheck" Content="業務時間バー"/>
                                <CheckBox x:Name="ShowIncomeCheck" Content="今日の収入"/>
                                <CheckBox x:Name="ShowCpuCheck" Content="CPU"/>
                                <CheckBox x:Name="ShowMemoryCheck" Content="メモリ"/>
                                <CheckBox x:Name="ShowGpuCheck" Content="GPU"/>
                                <CheckBox x:Name="ShowVramCheck" Content="VRAM"/>
                                <CheckBox x:Name="ShowDiskCheck" Content="ディスク"/>
                                <CheckBox x:Name="ShowNetworkCheck" Content="IPアドレス / DNS" Tag="Last"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WorkTab" Header="勤務と収入">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><StackPanel>
                                    <TextBlock Text="業務時間" Style="{StaticResource Heading}" Margin="0"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Target="{Binding ElementName=WorkStartTimeBox}" Content="勤務開始" Padding="0,0,0,8"/>
                                        <TextBox x:Name="WorkStartTimeBox" TabIndex="0" AutomationProperties.Name="勤務開始" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                        <Label Target="{Binding ElementName=LunchStartTimeBox}" Content="休憩開始" Padding="0,20,0,8"/>
                                        <TextBox x:Name="LunchStartTimeBox" TabIndex="2" AutomationProperties.Name="休憩開始" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Target="{Binding ElementName=WorkEndTimeBox}" Content="勤務終了" Padding="0,0,0,8"/>
                                        <TextBox x:Name="WorkEndTimeBox" TabIndex="1" AutomationProperties.Name="勤務終了" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                        <Label Target="{Binding ElementName=LunchEndTimeBox}" Content="休憩終了" Padding="0,20,0,8"/>
                                        <TextBox x:Name="LunchEndTimeBox" TabIndex="3" AutomationProperties.Name="休憩終了" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                    <TextBlock x:Name="WorkDurationText" Foreground="#155F80" TextWrapping="Wrap"/>
                                    <TextBlock Text="終了が開始より前の場合は、翌日までの勤務として扱います。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Label Target="{Binding ElementName=MonthlyBaseSalaryBox}" Content="基本給（月）" FontSize="16" FontWeight="SemiBold" Padding="0"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="MonthlyBaseSalaryBox" AutomationProperties.Name="基本給（月）" TextChanged="Input_Changed" LostFocus="SalaryBox_LostFocus"/>
                                    <TextBlock Grid.Column="1" Text="円" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Text="例：300,000（全角数字も使えます）" Style="{StaticResource Hint}"/>
                                <TextBlock Text="月20日・休憩を除く勤務時間で「今日の収入」を計算します。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ImageTab" Header="画像と起動">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="カスタム画像" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox x:Name="ShowCustomImageCheck" Content="カスタム画像を表示" Checked="ImageSetting_Changed" Unchecked="ImageSetting_Changed"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                <Border Height="112" Background="#F5F6FA" Margin="0,0,0,12">
                                    <Grid Margin="12">
                                        <Image x:Name="CustomImagePreview" Stretch="Uniform"/>
                                        <TextBlock x:Name="ImagePlaceholder" Text="ロゴやお気に入りの画像を選択" Foreground="#626B7E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="CustomImagePathBox" IsReadOnly="True" AutomationProperties.Name="画像ファイルの場所" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="画像を選択…" Click="SelectCustomImage_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearImageButton" Content="解除" Click="ClearCustomImage_Click"/>
                                </StackPanel>
                                <TextBlock Text="パネルの最下部に、横幅に合わせて表示します。&#10;元の画像ファイルは移動・削除せず保管してください。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ImageErrorText" Foreground="#B42335" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="起動" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Windows起動時に自動起動" Tag="Last"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E5ED" BorderThickness="0,1,0,0" Padding="28,16">
            <StackPanel>
                <Border x:Name="ValidationBanner" Background="#FFF1F2" CornerRadius="7" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText" Foreground="#B42335" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" Margin="0,0,8,0" Click="CancelButton_Click"/>
                        <Button x:Name="SaveButton" Content="保存" IsDefault="True" Background="{StaticResource Accent}" Foreground="#202536" BorderBrush="{StaticResource Accent}" MinWidth="88" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
