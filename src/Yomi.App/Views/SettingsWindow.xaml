<Window x:Class="Yomi.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="yomi 設定"
        Width="320" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <TextBlock Text="透明度" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0.0" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" Width="40"
                       TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="背景色" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="BackgroundBlackRadio" Content="黒" GroupName="BackgroundColor" Margin="0,0,16,0"/>
            <RadioButton x:Name="BackgroundWhiteRadio" Content="白" GroupName="BackgroundColor"/>
        </StackPanel>

        <TextBlock Text="業務時間" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="開始" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="WorkStartTimeBox" Grid.Column="1" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="終了" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="WorkEndTimeBox" Grid.Column="3"/>
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="休憩開始" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="LunchStartTimeBox" Grid.Column="1" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="終了" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="LunchEndTimeBox" Grid.Column="3"/>
        </Grid>
        <TextBlock Text="時刻は HH:mm 形式で入力(例: 09:00)" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>

        <TextBlock Text="基本給 (月)" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" Text="円" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="MonthlyBaseSalaryBox"/>
        </DockPanel>
        <TextBlock Text="月20日・休憩を除く勤務時間で換算" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>

        <TextBlock Text="表示項目" FontWeight="Bold" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowClockCheck" Content="日付・時計" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowWorkHoursCheck" Content="業務時間バー" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowIncomeCheck" Content="今日の収入" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowCpuCheck" Content="CPU" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowMemoryCheck" Content="メモリ" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowGpuCheck" Content="GPU" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowVramCheck" Content="VRAM" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowDiskCheck" Content="ディスク" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowNetworkCheck" Content="IPアドレス / DNS" Margin="0,0,0,10"/>

        <CheckBox x:Name="StartWithWindowsCheck" Content="Windows起動時に自動起動" Margin="0,0,0,16"/>

        <TextBlock Text="カスタム画像" FontWeight="Bold" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowCustomImageCheck" Content="カスタム画像を表示" Margin="0,0,0,4"/>
        <TextBox x:Name="CustomImagePathBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="画像を選択…" Padding="8,2" Click="SelectCustomImage_Click" Margin="0,0,8,0"/>
            <Button Content="解除" Padding="8,2" Click="ClearCustomImage_Click"/>
        </StackPanel>
        <TextBlock Text="一番下に横幅に合わせて表示します。&#10;選択した画像ファイルは元の場所に保管してください。"
                   Foreground="Gray" FontSize="10" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="キャンセル" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Width="80" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
