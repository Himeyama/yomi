<Window x:Class="Yomi.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="yomi 設定" Width="660" Height="760" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" ThemeMode="System" WindowStyle="None">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20808080"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#40808080"/></Trigger>
                    <Trigger Property="Tag" Value="Close"><Setter TargetName="Surface" Property="CornerRadius" Value="0,7,0,0"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;"/></Button>
                <Button Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click" ToolTip="最大化 / 元に戻す" AutomationProperties.Name="最大化 / 元に戻す">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Tag="Close" Click="CloseButton_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;"/></Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="28,12,28,18">
            <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="16,0,28,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="SettingsMenu" SelectedIndex="{Binding SelectedIndex, ElementName=SettingsTabs, Mode=TwoWay}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="設定メニュー">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border x:Name="Indicator" Width="3" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem Content="表示とデザイン" Padding="12,10"/><ListBoxItem Content="勤務と収入" Padding="12,10"/><ListBoxItem Content="画像と起動" Padding="12,10"/>
            </ListBox>
        <TabControl x:Name="SettingsTabs" Grid.Column="1" Margin="16,0,0,0">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
            <TabItem Header="表示とデザイン">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="デザイン" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox Margin="12,10" x:Name="EModeCheck" AutomationProperties.Name="Eモード" Checked="EModeCheck_Changed" Unchecked="EModeCheck_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Eモード"/>
                                        <TextBlock Text="黒背景・黄色の文字と外枠に切り替えます。" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="背景の透明度" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="OpacityCombo" Grid.Column="1" AutomationProperties.Name="背景の透明度"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="背景色" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="BackgroundColorCombo" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="背景色">
                                            <ComboBoxItem Content="黒" Tag="Black"/>
                                            <ComboBoxItem Content="白" Tag="White"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><StackPanel>
                                    <TextBlock Text="表示する項目" Style="{StaticResource Heading}" Margin="0"/>
                                    <TextBlock Text="必要な情報だけをパネルに表示できます。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                                <CheckBox Margin="12,10" x:Name="ShowClockCheck" Content="日付・時計"/>
                                <CheckBox Margin="12,10" x:Name="ShowWorkHoursCheck" Content="業務時間バー"/>
                                <CheckBox Margin="12,10" x:Name="ShowIncomeCheck" Content="今日の収入"/>
                                <CheckBox Margin="12,10" x:Name="ShowCpuCheck" Content="CPU"/>
                                <CheckBox Margin="12,10" x:Name="ShowMemoryCheck" Content="メモリ"/>
                                <CheckBox Margin="12,10" x:Name="ShowGpuCheck" Content="GPU"/>
                                <CheckBox Margin="12,10" x:Name="ShowVramCheck" Content="VRAM"/>
                                <CheckBox Margin="12,10" x:Name="ShowDiskCheck" Content="ディスク"/>
                                <CheckBox Margin="12,10" x:Name="ShowNetworkCheck" Content="IPアドレス / DNS" Tag="Last"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WorkTab" Header="勤務と収入">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><StackPanel>
                                    <TextBlock Text="業務時間" Style="{StaticResource Heading}" Margin="0"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Target="{Binding ElementName=WorkStartTimeBox}" Content="勤務開始" Padding="0,0,0,8"/>
                                        <TextBox x:Name="WorkStartTimeBox" TabIndex="0" AutomationProperties.Name="勤務開始" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                        <Label Target="{Binding ElementName=LunchStartTimeBox}" Content="休憩開始" Padding="0,20,0,8"/>
                                        <TextBox x:Name="LunchStartTimeBox" TabIndex="2" AutomationProperties.Name="休憩開始" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Target="{Binding ElementName=WorkEndTimeBox}" Content="勤務終了" Padding="0,0,0,8"/>
                                        <TextBox x:Name="WorkEndTimeBox" TabIndex="1" AutomationProperties.Name="勤務終了" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                        <Label Target="{Binding ElementName=LunchEndTimeBox}" Content="休憩終了" Padding="0,20,0,8"/>
                                        <TextBox x:Name="LunchEndTimeBox" TabIndex="3" AutomationProperties.Name="休憩終了" TextChanged="Input_Changed" LostFocus="TimeBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                    <TextBlock x:Name="WorkDurationText" TextWrapping="Wrap"/>
                                    <TextBlock Text="終了が開始より前の場合は、翌日までの勤務として扱います。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Label Target="{Binding ElementName=MonthlyBaseSalaryBox}" Content="基本給（月）" FontSize="16" FontWeight="SemiBold" Padding="0"/>
                                </Border>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="MonthlyBaseSalaryBox" AutomationProperties.Name="基本給（月）" TextChanged="Input_Changed" LostFocus="SalaryBox_LostFocus"/>
                                    <TextBlock Grid.Column="1" Text="円" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Text="例：300,000（全角数字も使えます）" Style="{StaticResource Hint}"/>
                                <TextBlock Text="月20日・休憩を除く勤務時間で「今日の収入」を計算します。" Style="{StaticResource Hint}"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ImageTab" Header="画像と起動">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="カスタム画像" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox Margin="12,10" x:Name="ShowCustomImageCheck" Content="カスタム画像を表示" Checked="ImageSetting_Changed" Unchecked="ImageSetting_Changed"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel>
                                <Border Height="112" Margin="0,0,0,12">
                                    <Grid Margin="12">
                                        <Image x:Name="CustomImagePreview" Stretch="Uniform"/>
                                        <TextBlock x:Name="ImagePlaceholder" Text="ロゴやお気に入りの画像を選択" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="CustomImagePathBox" IsReadOnly="True" AutomationProperties.Name="画像ファイルの場所" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="画像を選択…" Click="SelectCustomImage_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearImageButton" Content="解除" Click="ClearCustomImage_Click"/>
                                </StackPanel>
                                <TextBlock Text="パネルの最下部に、横幅に合わせて表示します。&#10;元の画像ファイルは移動・削除せず保管してください。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ImageErrorText" Foreground="#B42335" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}"><TextBlock Text="起動" Style="{StaticResource Heading}" Margin="0"/></Border>
                                <CheckBox Margin="12,10" x:Name="StartWithWindowsCheck" Content="Windows起動時に自動起動" Tag="Last"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
        <Border Grid.Row="3" Padding="28,16">
            <StackPanel>
                <Border x:Name="ValidationBanner" Background="#FFF1F2" CornerRadius="7" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText" Foreground="#B42335" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" Margin="0,0,8,0" Click="CancelButton_Click"/>
                        <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="88" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
