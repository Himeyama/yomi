<Window x:Class="Yomi.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="yomi 設定"
        Width="320" Height="475"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock Text="透明度" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0.0" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" Width="40"
                       TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="背景色" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="BackgroundBlackRadio" Content="黒" GroupName="BackgroundColor" Margin="0,0,16,0"/>
            <RadioButton x:Name="BackgroundWhiteRadio" Content="白" GroupName="BackgroundColor"/>
        </StackPanel>

        <TextBlock Text="表示項目" FontWeight="Bold" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowClockCheck" Content="日付・時計" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowCpuCheck" Content="CPU" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowMemoryCheck" Content="メモリ" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowGpuCheck" Content="GPU" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowVramCheck" Content="VRAM" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowDiskCheck" Content="ディスク" Margin="0,0,0,4"/>
        <CheckBox x:Name="ShowNetworkCheck" Content="IPアドレス / DNS" Margin="0,0,0,10"/>

        <CheckBox x:Name="StartWithWindowsCheck" Content="Windows起動時に自動起動" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="キャンセル" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Width="80" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
